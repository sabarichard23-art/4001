rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function pair(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function friends(a, b) {
      return get(/databases/$(database)/documents/friendships/$(pair(a, b))).data.status == 'accepted';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'handle', 'avatar', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 12
        && request.resource.data.handle is string
        && request.resource.data.handle.matches('^[a-z0-9_]{3,15}$')
        && request.resource.data.avatar is int
        && request.resource.data.avatar >= 0 && request.resource.data.avatar < 40;
      allow delete: if signedIn() && request.auth.uid == uid;
      match /private/{doc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && handle.matches('^[a-z0-9_]{3,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'status', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] != request.resource.data.users[1]
        && id == pair(request.resource.data.users[0], request.resource.data.users[1])
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && resource.data.from != request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    match /series/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['t0', 't1', 'members', 'w0', 'w1', 'at'])
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 4
        && request.resource.data.w0 + request.resource.data.w1 == 1;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.t0 == resource.data.t0
        && request.resource.data.t1 == resource.data.t1
        && request.resource.data.w0 >= resource.data.w0
        && request.resource.data.w1 >= resource.data.w1
        && request.resource.data.w0 + request.resource.data.w1
           == resource.data.w0 + resource.data.w1 + 1;
    }

    match /invites/{id} {
      allow read: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'code', 'fromName', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 12
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9]{4}$')
        && friends(request.auth.uid, request.resource.data.to);
      allow delete: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
  }
}
