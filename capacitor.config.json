{
  "appId": "com.richardsaba.tarneeb400",
  "appName": "400",
  "webDir": "www",
  "backgroundColor": "#1F2023",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#1F2023"
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "alert",
        "badge",
        "sound"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
